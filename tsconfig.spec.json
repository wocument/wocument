{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@wocument/schema": ["./packages/schema/src/index.ts"],
      "@wocument/parser": ["./packages/parser/src/index.ts"],
      "@wocument/resolved-document": ["./packages/resolved-document/src/index.ts"],
      "@wocument/resolver": ["./packages/resolver/src/index.ts"],
      "@wocument/assets": ["./packages/assets/src/index.ts"],
      "@wocument/text-engine": ["./packages/text-engine/src/index.ts"],
      "@wocument/layout": ["./packages/layout/src/index.ts"],
      "@wocument/renderer": ["./packages/renderer/src/index.ts"],
      "@wocument/visor": ["./packages/visor/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["packages/*/src/**/*.ts", "packages/cli/client/**/*.ts", "scripts/**/*.ts", "packages/*/test/**/*.ts", "packages/*/scripts/**/*.ts", "packages/*/examples/**/*.ts", "vitest.config.ts"]
}
