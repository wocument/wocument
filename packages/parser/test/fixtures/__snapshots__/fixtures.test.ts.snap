                    "value": {
                      "id": "leadin",
                      "raw": "leadin",
                      "t": "ident",
                    },
                  },
                ],
                "body": [
                  {
                    "type": "text",
                    "value": "The lever frame",
                  },
                ],
                "id": 17,
                "kind": "command",
                "name": "span",
                "source": {
                  "column": 3,
                  "length": 36,
                  "line": 37,
                },
              },
              "type": "command",
            },
            {
              "type": "text",
              "value": " at Abbotsbury Junction has forty-two levers, and Tom Whitlow can tell you which ones stick in the cold.",
            },
          ],
          "source": {
            "column": 3,
            "length": 142,
            "line": 37,
          },
        },
        {
          "id": 19,
          "kind": "paragraph",
          "runs": [
            {
              "type": "text",
              "value": "He has worked the box since 1987. When it closes next spring the line will be run from a control centre ninety miles away.",
            },
          ],
          "source": {
            "column": 1,
            "length": 126,
            "line": 40,
          },
        },
        {
          "attrs": [
            {
              "at": null,
              "key": "src",
              "source": {
                "column": 11,
                "length": 19,
                "line": 43,
              },
              "value": {
                "raw": "/sig/levers.jpg",
                "s": "/sig/levers.jpg",
                "t": "path",
              },
            },
            {
              "at": null,
              "key": "alt",
              "source": {
                "column": 32,
                "length": 36,
                "line": 43,
              },
              "value": {
                "raw": ""Painted signal levers in a row"",
                "s": "Painted signal levers in a row",
                "t": "string",
              },
            },
            {
              "at": null,
              "key": "cols",
              "source": {
                "column": 70,
                "length": 10,
                "line": 43,
              },
              "value": {
                "from": 10,
