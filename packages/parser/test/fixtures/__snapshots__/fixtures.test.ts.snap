          },
        },
        {
          "attrs": [
            {
              "at": null,
              "key": "span",
              "source": {
                "column": 12,
                "length": 8,
                "line": 52,
              },
              "value": {
                "id": "all",
                "raw": "all",
                "t": "enum",
              },
            },
          ],
          "body": [
            {
              "type": "text",
              "value": "A language of bells",
            },
          ],
          "id": 24,
          "kind": "command",
          "name": "subhead",
          "source": {
            "column": 3,
            "length": 39,
            "line": 52,
          },
        },
        {
          "id": 25,
          "kind": "paragraph",
          "runs": [
            {
              "type": "text",
              "value": "Signal boxes talk to each other in bell codes. Two beats, pause, one: is the line clear for an express passenger train?",
            },
          ],
          "source": {
            "column": 1,
            "length": 123,
            "line": 54,
          },
        },
        {
          "attrs": [
            {
              "at": null,
              "key": "cols",
              "source": {
                "column": 14,
                "length": 8,
