            },
          ],
          "body": [
            {
              "attrs": [],
              "body": [
                {
                  "type": "text",
                  "value": "Red for stop signals, black for points, blue for locks.",
                },
              ],
              "id": 21,
              "kind": "command",
              "name": "caption",
              "source": {
                "column": 5,
                "length": 65,
                "line": 45,
              },
            },
          ],
          "id": 20,
          "kind": "command",
          "name": "figure",
          "source": {
            "column": 3,
            "length": 208,
            "line": 43,
          },
        },
        {
          "id": 22,
          "kind": "paragraph",
          "runs": [
            {
              "type": "text",
              "value": "The work is mostly waiting, and then it is not.",
            },
          ],
          "source": {
            "column": 1,
            "length": 49,
            "line": 48,
          },
        },
        {
          "attrs": [],
          "body": null,
          "id": 23,
          "kind": "command",
          "name": "framebreak",
          "source": {
