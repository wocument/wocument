                "t": "boolean",
              },
            },
          ],
          "body": [
            {
              "id": 27,
              "kind": "paragraph",
              "runs": [
                {
                  "type": "text",
                  "value": "You learn to hear a mistake before you see it.",
                },
              ],
              "source": {
                "column": 63,
                "length": 54,
                "line": 60,
              },
            },
          ],
          "id": 26,
          "kind": "command",
          "name": "pullquote",
          "source": {
            "column": 3,
            "length": 115,
            "line": 60,
          },
        },
        {
          "id": 28,
          "kind": "paragraph",
          "runs": [
            {
              "type": "text",
              "value": "He learned them from a man who learned them in 1951. Nobody will learn them from him.",
            },
          ],
          "source": {
