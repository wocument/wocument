      "body": [
        {
          "attrs": [],
          "body": [
            {
              "type": "text",
              "value": "The season starts when the monsoon water drains and the ground turns white.",
            },
          ],
          "id": 20,
          "kind": "command",
          "name": "lede",
          "source": {
            "column": 3,
            "length": 82,
            "line": 40,
          },
        },
        {
          "id": 21,
          "kind": "paragraph",
          "runs": [
            {
              "type": "text",
              "value": "Families move out onto the flats in October and stay until June. They dig wells by hand, pump brine into shallow pans, and rake the crystals every morning before the heat.",
            },
          ],
          "source": {
            "column": 1,
            "length": 176,
            "line": 42,
          },
        },
      ],
