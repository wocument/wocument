{
  "name": "wmxdsl",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p tsconfig.spec.json",
    "print-tables": "vite-node packages/schema/scripts/print-tables.ts --",
    "gen:resolved": "vite-node packages/resolved-document/scripts/generate.ts",
    "playground": "npm run dev --workspace=@wmxdsl/playground"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "fast-check": "^3.19.0",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "license": "Apache-2.0"
}
